# startup-kit — copy to config.env and edit
#
# Every script in this kit sources this file. Nothing here is secret-safe:
# passwords belong in the database step, which prompts instead of storing them.

# ── identity ────────────────────────────────────────────────────────────────
DOMAIN=ninestores.in                 # vhost server_name
ALIASES="www.${DOMAIN}"              # extra server_name tokens (space separated)
ADMIN_USER=admin                     # sudo-capable login account
DEV_USER=ubuntu                      # account that owns the repo
SSH_PORT=22222                       # pick, then keep iptables/ufw in step

# ── paths ───────────────────────────────────────────────────────────────────
REPO=/home/ubuntu/ninestores         # the checkout; hhub/ is the ASDF system
APP_USER=hunchentoot
APP_GROUP=hhubgrp
APP_HOME=/home/hunchentoot
WWW_ROOT=/data/www/public            # nginx static root (NOT the repo's site/public)

# ── ports (all loopback-only except 80/443) ─────────────────────────────────
HTTP_PORT=4244                       # Hunchentoot acceptor
SWANK_PORT=4016                      # remote REPL / swank-eval.py
SHUTDOWN_PORT=6200                   # telnet here to stop the image
WEBPUSH_PORT=4345
SMS_PORT=4300
S3_PORT=4301
URL_PREFIX=/hhub/                    # nginx rewrite target for dynamic requests

# ── database ────────────────────────────────────────────────────────────────
DB_NAME=hhubdb
DB_USER=hhubuser
DB_HOST=localhost
SEED_SQL=hhubplatform.sql            # under installation/; see 07-install-database.sh

# ── optional ────────────────────────────────────────────────────────────────
SBCL_TARBALL_URL=                    # leave empty to use the distro sbcl
NODE_SERVERS="webpushserver smsserver fileserver"
